# -------------------------------------------------------------
# NeuroLens AI Backend Configuration
# -------------------------------------------------------------

PROJECT_NAME="NeuroLens AI Backend"
ENVIRONMENT="development"  # development | production | test
DEBUG=True
API_PREFIX="/api"

# Security & Authentication
# Generate with: openssl rand -hex 32
SECRET_KEY="neurolens-secret-key-change-in-production-min-32-chars-long"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS Origins (comma separated or JSON array)
# Never use wildcard "*" with credentials in production
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# MongoDB Atlas
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URL="mongodb://localhost:27017"
MONGODB_DB_NAME="neurolens_ai"

# ImageKit Storage
IMAGEKIT_PUBLIC_KEY="public_placeholder"
IMAGEKIT_PRIVATE_KEY="private_placeholder"
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/placeholder"

# ML Model Configuration
MODEL_DIR="./model_artifacts"
CLASSIFICATION_MODEL_PATH="./model_artifacts/EfficientNetV2B0_clahe_iid_best.keras"
SEGMENTATION_MODEL_PATH="./model_artifacts/unet_segmentation_best.keras"
DEEPLAB_INPUT_NORMALIZATION="zero_one"
# Confirm this order against the original Swin training notebook before production use.
SWIN_CLASS_NAMES='["glioma", "meningioma", "pituitary", "no_tumor"]'
SWIN_CLASS_MAPPING_CONFIRMED=false

# Safe Development Mode
# In development, explicitly labeled mock services can simulate latency & outputs
# In production, if model files are absent, API returns 503 Service Unavailable
USE_MOCK_MODELS_IN_DEV=true

# Research Copilot (backend only; never expose this key to Vite)
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_FALLBACK_MODEL="openai/gpt-oss-20b"

# Upload Constraints
MAX_UPLOAD_SIZE_MB=15
ALLOWED_EXTENSIONS="png,jpg,jpeg"
